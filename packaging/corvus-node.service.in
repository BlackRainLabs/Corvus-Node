[Unit]
Description=Corvus-Node privileged Node daemon
Documentation=https://www.BlackRainLabs.com
After=network-online.target

[Service]
Type=simple
EnvironmentFile=-ENV_FILE_PLACEHOLDER
ExecStart=PYTHON_PLACEHOLDER -m corvus_node serve
Restart=always
RestartSec=2
User=root
Group=root

[Install]
WantedBy=multi-user.target
